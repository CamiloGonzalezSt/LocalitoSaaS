  canvas [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#94A3B8">
      <TR>
        <TD BGCOLOR="#F8FAFC" WIDTH="180"><B>Socios / proveedores clave</B><BR/>Cloud y base de datos<BR/>Proveedor IA<BR/>Correo transaccional<BR/>Futuros: DTE/pagos autorizados</TD>
        <TD BGCOLOR="#F8FAFC" WIDTH="180"><B>Actividades clave</B><BR/>Desarrollo y QA<BR/>Onboarding<BR/>Soporte piloto<BR/>Validación con comercios<BR/>Seguridad y continuidad</TD>
        <TD BGCOLOR="#E8F3F0" WIDTH="220"><B>Propuesta de valor</B><BR/>Gestionar ventas, stock, caja y fiado desde el celular, con baja fricción de adopción y asistencia visual revisada por la persona.</TD>
        <TD BGCOLOR="#F8FAFC" WIDTH="180"><B>Relación con clientes</B><BR/>Prueba Pro 30 días<BR/>Onboarding guiado<BR/>Soporte humano en piloto<BR/>Autoservicio progresivo</TD>
