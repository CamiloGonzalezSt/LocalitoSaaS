
digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.45,
         fontname="Arial", label="LOCALITO · INTEGRACIÓN VENTA RÁPIDA CON IA", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#486581",
        penwidth=1.2, fontname="Arial", fontsize=12, margin="0.20,0.12", width=4.5];
  edge [color="#64748B", arrowsize=0.75, penwidth=1.05];

  a [label="1. PWA captura JPG / PNG / WebP"];
  b [label="2. POST /ai/quick-sale/analyze\nBearer + imageDataUrl"];
  c [label="3. API carga catálogo activo del tenant\nmáximo documental: 500 productos"];
  d [label="4. Provider REST\nGroq u OpenAI\nJSON estructurado + timeout"];
  e [label="5. API normaliza respuesta\nacepta solo IDs existentes del catálogo", fillcolor="#E8F3F0", color="#1F6F5F"];
  f [label="6. Usuario revisa\nproducto · cantidad · advertencias"];
  g [label="7. Venta se confirma por flujo POS normal\nLa IA NO modifica stock por sí sola", fillcolor="#EFF6FF", color="#1D4ED8"];
  err [label="429 / 5xx / respuesta inválida\nmensaje controlado + flujo manual disponible", fillcolor="#FEF2F2", color="#B91C1C"];

  a -> b -> c -> d -> e -> f -> g;
  d -> err [style=dashed];
}
