digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.48, ranksep=0.7, fontname="Arial", label="LOCALITO · CICLO DE CALIDAD DENTRO DE SCRUM", labelloc=t, fontsize=22];
