digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.46, ranksep=0.74, fontname="Arial", label="LOCALITO · ESCENARIO ARQUITECTÓNICO: CONTINUIDAD Y SINCRONIZACIÓN", labelloc=t, fontsize=22];
node [shape=box, style="rounded,filled", color="#486581", penwidth=1.3, fontname="Arial", fontsize=11.4, margin="0.20,0.12", fillcolor="#FFFFFF"];
edge [color="#64748B", fontname="Arial", fontsize=9.7, penwidth=1.08, arrowsize=0.74];
s1 [label="1. Usuario confirma la venta"];
decision [label="2. ¿Hay conexión?", shape=diamond, fillcolor="#FEF3C7", color="#A16207", penwidth=1.5];
queue [label="3A. La PWA guarda la venta\npendiente en IndexedDB", fillcolor="#EFF6FF", color="#1D4ED8"];
retry [label="4A. La venta queda visible\ny se reintenta al volver la red", fillcolor="#EFF6FF", color="#1D4ED8"];
online [label="3B. La PWA envía la venta\na la API"];
api [label="4B. La API valida\ne idempotencia", fillcolor="#E8F3F0", color="#1F6F5F", penwidth=2.2];
db [label="5. PostgreSQL registra o rechaza\ncon una causa explícita", shape=cylinder, fillcolor="#F0FDFA", color="#0F766E"];
result [label="6. La PWA informa éxito o rechazo\ny retira la cola solo si se registró"];
s1 -> decision; decision -> queue [label="No"]; queue -> retry; retry -> api; decision -> online [label="Sí"]; online -> api; api -> db; db -> result;
}