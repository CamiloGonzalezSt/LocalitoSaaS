digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.46, ranksep=0.74, fontname="Arial", label="LOCALITO · ESCENARIO ARQUITECTÓNICO: VENTA RÁPIDA CON IA", labelloc=t, fontsize=22];
node [shape=box, style="rounded,filled", color="#486581", penwidth=1.3, fontname="Arial", fontsize=11.5, margin="0.20,0.13", fillcolor="#FFFFFF"];
edge [color="#64748B", fontname="Arial", fontsize=9.8, penwidth=1.08, arrowsize=0.74];
s1 [label="1. El vendedor toma una foto\ndesde la PWA"];
s2 [label="2. La PWA comprime la imagen\ny la envía a la API"];
s3 [label="3. La API consulta el catálogo\naislado del negocio", fillcolor="#E8F3F0", color="#1F6F5F", penwidth=2.2];
s4 [label="4. La API envía imagen y contexto\nal proveedor visual", fillcolor="#FFF7ED", color="#C2410C"];
s5 [label="5. El proveedor IA devuelve\nuna propuesta estructurada", fillcolor="#FFF7ED", color="#C2410C"];
s6 [label="6. La API filtra IDs y valida\ncontra el catálogo permitido"];
s7 [label="7. La PWA muestra la propuesta\npara revisión humana"];
s8 [label="8. El vendedor corrige o confirma\nantes de agregar al ticket"];
s9 [label="9. El ticket POS continúa\nsu flujo de cobro"];
s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> s9;
}