
digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.45,
         fontname="Arial", label="LOCALITO · CONTINUIDAD OFFLINE E INTEGRACIÓN CON API", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#486581",
        penwidth=1.2, fontname="Arial", fontsize=12, margin="0.20,0.12", width=4.5];
  edge [color="#64748B", arrowsize=0.75, penwidth=1.05];

  a [label="Venta creada sin conexión"];
  b [label="IndexedDB\ncola por negocio / usuario"];
  c [label="Recupera conexión"];
  d [label="POST /sales\nIdempotency-Key"];
  ok [label="2xx\nventa registrada una vez\nstock actualizado", fillcolor="#DCFCE7", color="#15803D"];
  review [label="400 / 404 / 409 / 413 / 422\nqueda pendiente de revisión", fillcolor="#FEF3C7", color="#A16207"];
  retry [label="Red / 401 / 403 / 429 / 5xx\ndetiene ciclo y se reintenta después", fillcolor="#FEE2E2", color="#B91C1C"];

  a -> b -> c -> d;
  d -> ok;
  d -> review;
  d -> retry;
}
