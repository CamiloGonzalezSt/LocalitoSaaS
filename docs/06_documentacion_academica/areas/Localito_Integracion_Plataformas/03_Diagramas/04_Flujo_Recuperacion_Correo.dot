
digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.45,
         fontname="Arial", label="LOCALITO · INTEGRACIÓN DE CORREO TRANSACCIONAL", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#486581",
        penwidth=1.2, fontname="Arial", fontsize=12, margin="0.20,0.12", width=4.5];
  edge [color="#64748B", arrowsize=0.75, penwidth=1.05];

  a [label="1. POST /auth/password-reset/request"];
  b [label="2. API genera token aleatorio\nalmacena solo hash + expiración"];
  c [label="3. Resolver proveedor de correo"];
  r [label="Resend\nPOST API + Idempotency-Key", fillcolor="#F5F3FF", color="#6D28D9"];
  g [label="Gmail\nSMTP TLS puerto 465", fillcolor="#FFF7ED", color="#C2410C"];
  d [label="4. Usuario recibe enlace\nválido una sola vez"];
  e [label="5. POST /auth/password-reset/confirm"];
  f [label="6. Nueva contraseña persistida\nrespuesta controlada", fillcolor="#E8F3F0", color="#1F6F5F"];

  a -> b -> c;
  c -> r;
  c -> g;
  r -> d;
  g -> d;
  d -> e -> f;
}
