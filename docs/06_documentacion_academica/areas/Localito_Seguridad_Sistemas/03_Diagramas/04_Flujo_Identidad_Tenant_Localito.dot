
digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.35,nodesep=0.46,ranksep=0.65,fontname="Arial",
label="LOCALITO · FLUJO DE IDENTIDAD, ROL Y AISLAMIENTO",labelloc=t,fontsize=22];
node [shape=box,style="rounded,filled",fillcolor="#FFFFFF",color="#486581",penwidth=1.2,fontname="Arial",fontsize=11,margin="0.18,0.11"];
edge [color="#64748B",fontname="Arial",fontsize=9.4,arrowsize=0.72];

login [label="Login / registro\nvalidar input + rate limit"];
hash [label="Password\nscrypt + salt",fillcolor="#F5F3FF",color="#6D28D9"];
session [label="Sesión\ntoken aleatorio o firmado\nexpiración / revocación",fillcolor="#EFF6FF",color="#1D4ED8"];
role [label="Autorización\nsystem_admin · owner · seller"];
tenant [label="Aislamiento\nuser.tenantId → negocio_id",fillcolor="#E8F3F0",color="#1F6F5F",penwidth=2.0];
db [label="PostgreSQL\nRLS habilitado\nanon/authenticated revocados",shape=cylinder,fillcolor="#F0FDFA",color="#0F766E"];
audit [label="Auditoría\nacción · usuario · negocio"];

login -> hash -> session -> role -> tenant -> db;
tenant -> audit [style=dashed];
}
